DISCORD_TOKEN=put-your-discord-bot-token-here

# Optional: register slash commands instantly in one test server instead of globally.
# COMMAND_GUILD_ID=123456789012345678

# Optional: per-guild storage quota. Default is 10 decimal MB / Mo.
# GUILD_STORAGE_LIMIT_MB=10
# GUILD_STORAGE_LIMIT_BYTES=10000000

# Optional: shown by /privacy and /settings.
# BOT_OPERATOR=Clause operator
# PRIVACY_CONTACT=git-spectre@proton.me

# Required for AI summaries and moderation.
# API_KEY=put-your-ai-api-key-here
# AI_ENDPOINT_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini
# AI_MAX_TOKENS=300
# AI_SUMMARY_MAX_TOKENS=1200
# AI_RULE_GENERATION_MAX_TOKENS=2000
# AI_REASONING_EFFORT=none
